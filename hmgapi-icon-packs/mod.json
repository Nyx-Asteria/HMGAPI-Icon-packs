{
  "id": "hmgapi-icon-packs",
  "name": "HMGAPI Icon Packs",
  "version": "1.0.0-rc.12",
  "hmgapi": ">=1.1.0-rc.3",
  "authors": [
    "Nyx-Asteria"
  ],
  "license": "MIT",
  "description": "Selectable Kia and Hyundai PNG icon packs for mod tiles, with runtime factory icon replacements.",
  "hooks": {
    "jar": "hooks.jar",
    "entry": "hmgapi.iconpacks.IconPacks",
    "points": {
      "framework.resources.get_drawable": "replace",
      "launcher.menu_entry.new": "observe",
      "launcher.menu_list.load": "observe"
    }
  }
}
